{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "answer",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "question",
    "answer",
    "scope",
    "confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {},
    "scope": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "campaign",
            "employer",
            "question"
          ]
        }
      }
    },
    "confirmation": {
      "enum": [
        "confirmed",
        "needs_confirmation",
        "conflicting",
        "confirmed_absent"
      ]
    },
    "confirmed_by": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_at": {
      "type": "string",
      "minLength": 1
    },
    "fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
