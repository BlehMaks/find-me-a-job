{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "timestamp",
    "time_zone",
    "actor",
    "observed",
    "workspace_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "time_zone": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "boolean"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "object",
        "array",
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object"
    }
  }
}
