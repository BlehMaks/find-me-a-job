{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "fact_ids",
    "safe_wording",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "minItems": 1
    },
    "safe_wording": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "withdrawn"
      ]
    },
    "fact_versions": {
      "type": "object"
    },
    "forbidden_interpretations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
