{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "campaign-policy",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "approved",
    "markets",
    "languages",
    "approved_titles",
    "hard_exclusions",
    "resource_classes",
    "expansion_authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "approved": {
      "type": "boolean"
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approved_titles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hard_exclusions": {
      "type": "object"
    },
    "resource_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expansion_authority": {
      "type": "boolean"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "desired_duties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disliked_duties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_grants": {
      "type": "object"
    }
  }
}
