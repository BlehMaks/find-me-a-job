{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fact",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "subject",
    "field",
    "value",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "status": {
      "enum": [
        "document_supported",
        "candidate_confirmed",
        "needs_confirmation",
        "conflicting",
        "confirmed_absent"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confirmed_by": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_at": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "qualifiers": {
      "type": [
        "string",
        "object",
        "array"
      ]
    }
  }
}
