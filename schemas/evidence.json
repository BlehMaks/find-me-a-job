{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "confidence",
    "sensitivity",
    "scope",
    "extraction_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "link": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "minLength": 1
    },
    "sensitivity": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": [
        "string",
        "object"
      ]
    },
    "extraction_status": {
      "enum": [
        "pending",
        "extracted",
        "failed",
        "unavailable"
      ]
    }
  }
}
